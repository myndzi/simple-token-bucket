{
  "name": "simple-token-bucket",
  "author": "Kristopher Reeves",
  "license": "MIT",
  "version": "3.0.0",
  "description": "A straightforward token bucket implementation with no entanglements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myndzi/simple-token-bucket.git"
  },
  "keywords": [
    "token",
    "bucket",
    "rate",
    "limit"
  ],
  "bugs": {
    "url": "https://github.com/myndzi/simple-token-bucket/issues"
  },
  "homepage": "https://github.com/myndzi/simple-token-bucket#readme",
  "scripts": {
    "test": "vitest run",
    "clean": "rm -rf ./lib/*",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:cjs": "tsc -p ./tsconfig.cjs.json && mv lib/cjs/index.js lib/cjs/index.cjs",
    "prepack": "npm run build",
    "test:smoke": "sh smoke/prepare.sh && node .smoke/smoke.cjs && node .smoke/smoke.mjs",
    "test:esm": "TEST_TARGET=lib/esm/index.js vitest run",
    "test:cjs": "TEST_TARGET=lib/cjs/index.cjs vitest run"
  },
  "type": "module",
  "main": "./lib/esm/index.js",
  "types": "./lib/esm/types/index.d.ts",
  "files": [
    "LICENSE",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
